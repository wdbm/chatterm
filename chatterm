    def _append_bubble(self, side: str, timestamp: str, text: str, is_command: bool) -> None:
        stretch_item = self.chat_layout.takeAt(self.chat_layout.count() - 1)
        bubble = BubbleWidget(side=side, timestamp=timestamp, text=text, is_command=is_command)
        self.chat_layout.addWidget(bubble)
        if stretch_item is not None:
            self.chat_layout.addItem(stretch_item)
        self._update_bubble_widths()
        # Scroll after the widget is added, and again after the layout
        # settles.
        QtCore.QTimer.singleShot(0, self._scroll_chat_to_bottom)
        QtCore.QTimer.singleShot(50, self._scroll_chat_to_bottom)

    def _scroll_chat_to_bottom(self) -> None:
        bar = self.chat_scroll.verticalScrollBar()
        bar.setValue(bar.maximum())

    def _send_command_from_input(self) -> None:
        cmd = self.input_edit.toPlainText().rstrip()
        if not cmd:
            return

        ts = utc_timestamp_iso_seconds()

        self._append_bubble(side="right", timestamp=ts, text=cmd, is_command=True)
        self.session_log.append(SessionEntry(timestamp=ts, kind="command", text=cmd))

        self.shell.send_command(cmd)

        self.input_edit.clear()
        self.input_edit.setFocus()

    def _send_keys_from_field(self) -> None:
        s = self.keys_edit.text()
        if s == "":
            return

        # Send as if typed, followed by Enter.
        self.shell.send_keys(s + "\n")

        ts = utc_timestamp_iso_seconds()
        self.session_log.append(SessionEntry(timestamp=ts, kind="note", text=f"Sent keys: {s!r}"))

        self.keys_edit.clear()
        self.keys_edit.setFocus()

    @QtCore.Slot(str)
    def _on_stream_data(self, text: str) -> None:
        # Strip ANSI/VT control sequences for a cleaner stream pane.
        clean = strip_ansi(text)

        cursor = self.stream_view.textCursor()
        cursor.movePosition(QtGui.QTextCursor.End)
        cursor.insertText(clean)
        self.stream_view.setTextCursor(cursor)
        self.stream_view.ensureCursorVisible()

    @QtCore.Slot(str, str, int)
    def _on_command_completed(self, tag: str, captured_output: str, exit_code: int) -> None:
        ts = utc_timestamp_iso_seconds()

        output_text = captured_output
        if output_text.strip() == "":
            output_text = f"(no captured output; exit code {exit_code})"
        else:
            output_text = f"{output_text}\n\n(exit code {exit_code})"

        self._append_bubble(side="left", timestamp=ts, text=output_text, is_command=False)
        self.session_log.append(SessionEntry(timestamp=ts, kind="output", text=output_text))

    def _toggle_stream_pane(self) -> None:
        stream_is_visible = self.stream_view.isVisible()
        if stream_is_visible:
            self.stream_view.setVisible(False)
            self.toggle_stream_action.setText("Show stream pane")
        else:
            self.stream_view.setVisible(True)
            self.toggle_stream_action.setText("Hide stream pane")
            self.splitter.setSizes([220, 540])

    def _save_session_log(self) -> None:
        default_name = f"chat-terminal-session-{time.strftime('%Y-%m-%dT%H%M%SZ', time.gmtime())}.txt"
        path, _ = QtWidgets.QFileDialog.getSaveFileName(
            self,
            "Save session log",
            default_name,
            "Text files (*.txt);;All files (*)",
        )
        if not path:
            return

        lines = []
        for entry in self.session_log:
            lines.append(f"[{entry.timestamp}] {entry.kind}\n{entry.text}\n")

        payload = "\n".join(lines).rstrip() + "\n"
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(payload)
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Save failed", f"Could not write file:\n{e}")
            return

        QtWidgets.QMessageBox.information(self, "Saved", f"Session log saved at:\n{path}")

    def _clear_chat(self) -> None:
        while self.chat_layout.count() > 1:
            item = self.chat_layout.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()
        self.session_log.append(SessionEntry(timestamp=utc_timestamp_iso_seconds(), kind="note", text="Chat cleared"))

    def resizeEvent(self, event: QtGui.QResizeEvent) -> None:
        super().resizeEvent(event)
        self._update_bubble_widths()

    def _update_bubble_widths(self) -> None:
        viewport_w = self.chat_scroll.viewport().width()
        if viewport_w <= 0:
            return

        min_w = int(viewport_w * 0.75)
        max_w = int(viewport_w * 0.95)

        for i in range(self.chat_layout.count()):
            item = self.chat_layout.itemAt(i)
            w = item.widget()
            if isinstance(w, BubbleWidget):
                w.set_width_constraints(min_w, max_w)


