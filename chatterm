def utc_timestamp_iso_seconds() -> str:
    return time.strftime("%Y-%m-%d %H:%M:%SZ", time.gmtime())


def uuid4t8() -> str:
    """
    Return an 8-character tag derived from UUID4 with at least one letter.
    """
    import uuid
    while True:
        s = str(uuid.uuid4()).replace("-", "")[:8]
        if re.search(r"[a-fA-F]", s):
            return s


def strip_ansi(s: str) -> str:
    """
    Remove common ANSI/VT escape sequences (with minimal code).
    """
    ansi_re = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
    s = ansi_re.sub("", s)
    s = s.replace("\r\n", "\n").replace("\r", "\n")
    return s


